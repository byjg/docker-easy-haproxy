<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ title }}</title>
<style>
:root{--bg:#f6f6f4;--card:#fff;--fg:#222;--muted:#666;--accent:#8a7f2e;--code:#efefea}
@media (prefers-color-scheme:dark){:root{--bg:#1b1b1a;--card:#262624;--fg:#eee;--muted:#aaa;--accent:#c2c63c;--code:#33332f}}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,sans-serif}
main{max-width:720px;margin:0 auto;padding:32px 16px}
header{display:flex;align-items:center;gap:16px}
header img{width:72px;height:72px}
h1{font-size:1.5rem;margin:0}
p.lead{color:var(--muted);margin:4px 0 0}
section{background:var(--card);border-radius:8px;padding:12px 16px;margin-top:16px}
h2{font-size:1.05rem;margin:0 0 4px}
code{background:var(--code);padding:1px 4px;border-radius:4px;font-size:.9em}
a{color:var(--accent)}
footer{color:var(--muted);font-size:.9rem;margin-top:24px}
{% block style %}{% endblock %}
</style>
</head>
<body>
<main>
{% block content %}{% endblock %}
</main>
</body>
</html>
